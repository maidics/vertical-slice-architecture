{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "group:all", "schedule:weekly"],
  "dependencyDashboard": false,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": ["security"]
  },
  "packageRules": [
    {
      "description": "Minor and patch updates only, security fixes included. Keeps packages and the SDK on their current major (no net11.0 bumps).",
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}