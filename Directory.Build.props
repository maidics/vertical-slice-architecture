<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-qhrr-8q5h-9q3h" />
  </ItemGroup>

  <!--#if (TemplateDev) -->
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);TemplateDev</DefineConstants>
  </PropertyGroup>
  <!--#endif -->
  <PropertyGroup>
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --results-directory "$(ArtifactsPath)/test-results"</TestingPlatformCommandLineArguments>
  </PropertyGroup>
</Project>
