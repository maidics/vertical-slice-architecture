<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Will fail to pack the package because it is missing the target framework from lib -->
    <NoWarn>NU5128</NoWarn>
    <NoDefaultExcludes>true</NoDefaultExcludes>

    <PackageId>Vertical.Slice.Architecture</PackageId>
    <Version>4.0.0</Version>
    <PackageType>Template</PackageType>

    <Title>Vertical Slice Architecture Template</Title>
    <Authors>Maidics Dávid</Authors>
    <Description>Vertical Slice Architecture template for ASP.NET.</Description>
    <PackageTags>vertical-slice architecture vsa template csharp dotnet minimal-api</PackageTags>

    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/maidics/VerticalSliceArchitecture.git</RepositoryUrl>

    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <NoBuild>true</NoBuild>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeContentInPack>true</IncludeContentInPack>
    <ContentTargetFolders>content</ContentTargetFolders>

    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />

    <Content
      Include="**\*"
      Exclude="
        **\.git\**;
        **\.github\**;
        **\.gitattributes;
        **\renovate.json;
    
        **\.vs\**;
        **\.idea\**;
        **\.claude\**;
        **\*.user;
        **\AGENTS.md;
    
        **\artifacts\**;
        **\.nuget\**;
        *.nupkg;
        **\nuspec.csproj;
    
        **\docs\**;
        **\scratch\**;
        **\scripts\**;
        **\pack-install.sh;
        **\v1.json;
        **\LICENSE;
    
        **\*.db;
        **\*.db-shm;
        **\*.db-wal;
        **\*.db-journal;
    
        **\VsaTemplate.Pipeline\**;
        **\VsaTemplate.Pipeline.Tests\**;
    "/>

    <!--Exclude everything from VsaTemplate.Pipeline/ & VsaTemplate.Pipeline.Tests/ but then include what is required for the AddModularPipeline option -->
    <Content Include="**\VsaTemplate.Pipeline\Program.cs;**\VsaTemplate.Pipeline\VsaTemplate.Pipeline.csproj;**\VsaTemplate.Pipeline.Tests.csproj" />
  </ItemGroup>
</Project>
