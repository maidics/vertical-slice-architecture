{
  "$schema": "http://json.schemastore.org/template",
  "author": "Maidics Dávid",
  "classifications": [ "Web", "WebAPI", "Architecture" ],
  "name": "Vertical Slice Architecture Template",
  "identity": "Vsa.MinimalApi.Template",
  "shortName": "vsa-sln",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "VsaTemplate",
  "preferNameDirectory": true,
  "symbols": {
    "AddTemplateTests": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "displayName": "Add template tests",
      "description": "Includes tests for the infrastructure shipped with the template (Result, endpoint filters, extension methods, interceptors and more) in the Tests project."
    },
    "AddExamples": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "displayName": "Add example feature and tests",
      "description": "Example implementations and tests: an Example entity, CRUD IRequest/IRequestHandler handlers and Minimal API endpoints and tests showing the template in use."
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(!AddTemplateTests)",
          "exclude": [
            "**/VsaTemplate.Tests/Common/Extensions/EndpointRouteBuilderExtensionTests.cs",
            "**/VsaTemplate.Tests/Common/Extensions/MethodInfoExtensionTests.cs",
            "**/VsaTemplate.Tests/Common/Extensions/ResultExtensionTests.cs",
            "**/VsaTemplate.Tests/Common/Extensions/RouteHandlerBuilderExtensionTests.cs",
            "**/VsaTemplate.Tests/Common/Extensions/ServiceCollectionExtensionTests.cs",
            "**/VsaTemplate.Tests/Common/Models/ResultTests.cs",
            "**/VsaTemplate.Tests/Common/Pipeline/LoggingFilterTests.cs",
            "**/VsaTemplate.Tests/Common/Pipeline/PerformanceFilterTests.cs",
            "**/VsaTemplate.Tests/Common/Pipeline/ValidationFilterTests.cs",
            "**/VsaTemplate.Tests/Domain/BaseClasses/ValueObjectTests.cs",
            "**/VsaTemplate.Tests/Infrastructure/CurrentUserTests.cs",
            "**/VsaTemplate.Tests/Infrastructure/Database/Interceptors/AuditableEntityInterceptorTests.cs",
            "**/VsaTemplate.Tests/Infrastructure/Database/Interceptors/EntityEntryExtensionTests.cs",
            "**/VsaTemplate.Tests/TestInfrastructure/TemplateTests/**"
          ]
        },
        {
          "condition": "(!AddExamples)",
          "exclude": [
            "**/Examples/**",
            "**/Example.cs",
            "**/ExampleConfiguration.cs",
            "**/ExampleConfigurationTests.cs"
          ]
        }
      ]
    }
  ]
}