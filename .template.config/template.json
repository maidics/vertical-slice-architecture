{
  "$schema": "http://json.schemastore.org/template",
  "author": "Maidics Dávid",
  "classifications": [ "Web", "WebAPI", "Architecture" ],
  "name": "Vertical Slice Architecture Template",
  "identity": "Vsa.MinimalApi.Template",
  "shortName": "vsa-sln",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "VsaTemplate",
  "preferNameDirectory": true,
  "symbols": {
    "AddTemplateTests": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "displayName": "Add template test project",
      "description": "Includes the template test project in the generated output."
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(!AddTemplateTests)",
          "exclude": [
            "**/VsaTemplate.TemplateTests/**"
          ]
        }
      ]
    }
  ]
}