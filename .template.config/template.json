{
  "$schema": "http://json.schemastore.org/template",
  "author": "Maidics Dávid",
  "classifications": [ "Web", "WebAPI", "Architecture" ],
  "name": "Vertical Slice Architecture Template",
  "identity": "Vsa.MinimalApi.Template",
  "shortName": "vsa-sln",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "VsaTemplate",
  "preferNameDirectory": true,
  "symbols": {
    "AddExamples": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "displayName": "Add example feature and tests",
      "description": "Example implementations and tests: an Example entity, CRUD IRequest/IRequestHandler handlers and Minimal API endpoints and tests showing the template in use."
    },
    "AddModularPipelines": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "displayName": "Add Pipeline project with ModularPipelines package",
      "description": "Write your CI pipeline in C# using ModularPipelines package. This option scaffolds the Pipeline and Pipeline.Tests projects."
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(!AddExamples)",
          "exclude": [
            "**/Examples/**",
            "**/Example.cs",
            "**/ExampleConfiguration.cs",
            "**/ExampleConfigurationTests.cs"
          ]
        },
        {
          "condition": "(!AddModularPipelines)",
          "exclude": [
            "**/VsaTemplate.Pipeline/**",
            "**/VsaTemplate.Pipeline.Tests/**"
          ]
        }
      ]
    }
  ]
}