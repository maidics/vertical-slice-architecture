{
  "$schema": "http://json.schemastore.org/template",
  "author": "Maidics Dávid",
  "classifications": [ "Web", "WebAPI", "Architecture" ],
  "name": "Vertical Slice Architecture Template",
  "identity": "Vsa.MinimalApi.Template",
  "shortName": "vsa-sln",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "VsaTemplate",
  "preferNameDirectory": true,
  "symbols": {
    "AddTemplateTests": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "displayName": "Add template test project",
      "description": "Includes the template test project in the generated output."
    },
    "AddExamples": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "displayName": "Add example feature and tests",
      "description": "Example implementations and tests: an Example entity, CRUD IRequest/IRequestHandler handlers, and IDomainEvent/IDomainEventHandler handlers, plus Minimal API endpoints and tests showing the template in use."
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(!AddTemplateTests)",
          "exclude": [
            "**/VsaTemplate.TemplateTests/**",
          ]
        },
        {
          "condition": "(!AddExamples)",
          "exclude": [
            "**/Examples/**"
          ]
        }
      ]
    }
  ]
}